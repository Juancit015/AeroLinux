style "aero-gtk2" {
    bg[NORMAL] = "#ffffff"
    bg[PRELIGHT] = "#f5f5f5"
    bg[ACTIVE] = "#e8e8e8"
    bg[INSENSITIVE] = "#f5f5f5"
    bg[SELECTED] = "#3c6eb4"
    fg[NORMAL] = "#333333"
    fg[PRELIGHT] = "#333333"
    fg[ACTIVE] = "#ffffff"
    fg[INSENSITIVE] = "#999999"
    fg[SELECTED] = "#ffffff"
    base[NORMAL] = "#ffffff"
    base[PRELIGHT] = "#ffffff"
    base[ACTIVE] = "#f5f5f5"
    base[INSENSITIVE] = "#f5f5f5"
    base[SELECTED] = "#3c6eb4"
    text[NORMAL] = "#333333"
    text[PRELIGHT] = "#333333"
    text[ACTIVE] = "#ffffff"
    text[INSENSITIVE] = "#999999"
    text[SELECTED] = "#ffffff"
}

style "aero-button-gtk2" {
    bg[NORMAL] = "#3c6eb4"
    bg[PRELIGHT] = "#51a2da"
    bg[ACTIVE] = "#2c4e82"
    bg[INSENSITIVE] = "#51a2da"
    fg[NORMAL] = "#ffffff"
    fg[PRELIGHT] = "#ffffff"
    fg[ACTIVE] = "#ffffff"
    fg[INSENSITIVE] = "#ffffff"
}

style "aero-entry-gtk2" {
    bg[NORMAL] = "#ffffff"
    bg[PRELIGHT] = "#ffffff"
    fg[NORMAL] = "#333333"
    fg[PRELIGHT] = "#333333"
    base[NORMAL] = "#ffffff"
    text[NORMAL] = "#333333"
}

style "aero-scrollbar-gtk2" {
    bg[NORMAL] = "#e0e0e0"
    bg[PRELIGHT] = "#51a2da"
    bg[ACTIVE] = "#3c6eb4"
    min_slider_length = 20
}

style "aero-treeview-gtk2" {
    base[NORMAL] = "#ffffff"
    bg[NORMAL] = "#ffffff"
    fg[NORMAL] = "#333333"
    base[SELECTED] = "#3c6eb4"
    fg[SELECTED] = "#ffffff"
}

style "aero-menu-gtk2" {
    bg[NORMAL] = "#ffffff"
    fg[NORMAL] = "#333333"
    bg[PRELIGHT] = "#3c6eb4"
    fg[PRELIGHT] = "#ffffff"
    bg[SELECTED] = "#3c6eb4"
    fg[SELECTED] = "#ffffff"
}

class "GtkWidget" style "aero-gtk2"
class "GtkButton" style "aero-button-gtk2"
class "GtkEntry" style "aero-entry-gtk2"
class "GtkTextView" style "aero-treeview-gtk2"
class "GtkTreeView" style "aero-treeview-gtk2"
class "GtkMenu" style "aero-menu-gtk2"
widget_class "*GtkMenu*" style "aero-menu-gtk2"
widget_class "*GtkMenuBar*" style "aero-menu-gtk2"
widget_class "*GtkMenuItem*" style "aero-menu-gtk2"
widget_class "*GtkToolbar*" style "aero-menu-gtk2"
widget "GtkScrollbar" style "aero-scrollbar-gtk2"
