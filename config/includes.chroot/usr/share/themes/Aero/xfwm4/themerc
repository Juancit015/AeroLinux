# Aero Linux — xfwm4 window manager theme
# Clean, modern title bars with Aero blue palette

# Colors
active_text_color=#FFFFFF
inactive_text_color=#999999
title_active_color=#2C4E82
title_active_color_2=#2C4E82
title_inactive_color=#D0D0D0
title_inactive_color_2=#D0D0D0

# Active window border colors
active_border_color=#2C4E82
inactive_border_color=#D0D0D0

# Title bar
full_width_title=true
title_alignment=center
title_horizontal_offset=0
title_vertical_offset_active=0
title_vertical_offset_inactive=0
title_shadow_active=false
title_shadow_inactive=false

# Button layout: [O]ptions [M]enu | [S]tick [H]ide [Maximize] [C]lose
button_layout=O|HMC
button_offset=4
button_spacing=4

# Frame borders (thin)
frame_border_top=0
frame_border_bottom=2
frame_border_left=2
frame_border_right=2

# Misc
show_app_icon=true
maximized_offset=0
shadow_delta_height=2
shadow_delta_width=0
shadow_delta_x=0
shadow_delta_y=-8
shadow_opacity=60
